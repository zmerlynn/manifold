+// Reconcile the collected cells: union-find over delta-0 links (cross-face
+// twin mesh sub-edges + intra-face non-seam sub-edges), then set each class's
+// reconciled w_above to the area-weighted consensus.  A no-op on any class
+// already consistent (resolving corpus).
+void FloodReconcile() {
+  const int n = static_cast<int>(gFlood.cells.size());
+  std::vector<int> uf(n);
+  for (int i = 0; i < n; ++i) uf[i] = i;
+  auto find = [&](int x) {
+    while (uf[x] != x) x = uf[x] = uf[uf[x]];
+    return x;
+  };
+  auto unite = [&](int a, int b) { uf[find(a)] = find(b); };
+  // cross-face: group non-seam mesh sub-edges by (meshId, key).
+  std::map<std::array<int64_t, 7>, std::vector<int>> meshGroup;
+  // intra-face: group interior non-seam sub-edges by (face, key).
+  std::map<std::array<int64_t, 7>, std::vector<int>> intraGroup;
+  for (int i = 0; i < n; ++i)
+    for (const FloodSubEdge& e : gFlood.cells[i].edges) {
+      if (e.kind == 0) {
+        std::array<int64_t, 7> g = {e.meshId,  e.key[0], e.key[1], e.key[2],
+                                    e.key[3],   e.key[4], e.key[5]};
+        meshGroup[g].push_back(i);
+      } else if (e.kind == 2) {
+        std::array<int64_t, 7> g = {gFlood.cells[i].face, e.key[0], e.key[1],
+                                    e.key[2], e.key[3], e.key[4], e.key[5]};
+        intraGroup[g].push_back(i);
+      }
+    }
+  auto linkGroup = [&](const std::vector<int>& v) {
+    for (size_t k = 1; k < v.size(); ++k) unite(v[0], v[k]);
+  };
+  for (auto& kv : meshGroup) linkGroup(kv.second);
+  for (auto& kv : intraGroup) linkGroup(kv.second);
+  // per class: area-weighted vote on w_above; keep each cell's (wBelow-wAbove).
+  std::map<int, std::map<int, double>> classVote;
+  for (int i = 0; i < n; ++i)
+    classVote[find(i)][gFlood.cells[i].wAbove] += gFlood.cells[i].area;
+  std::map<int, int> classWA;
+  for (auto& kv : classVote) {
+    int best = 0;
+    double bw = -1.0;
+    for (auto& vv : kv.second)
+      if (vv.second > bw || (vv.second == bw && vv.first < best)) {
+        bw = vv.second;
+        best = vv.first;
+      }
+    classWA[kv.first] = best;
+  }
+  int nFlip = 0, nInconsistentClass = 0;
+  std::map<int, int> classCount, classInconsistent;
+  for (auto& kv : classVote)
+    if (kv.second.size() > 1) ++nInconsistentClass;
+  for (int i = 0; i < n; ++i) {
+    FloodCell& c = gFlood.cells[i];
+    const int wa = classWA[find(i)];
+    c.recWBelow = wa + (c.wBelow - c.wAbove);
+    c.recWAbove = wa;
+    if (c.recWAbove != c.wAbove) ++nFlip;
+  }
+  if (std::getenv("FLOOD_CENSUS") != nullptr) {
+    int meshLinks = 0, intraLinks = 0;
+    for (auto& kv : meshGroup)
+      if (kv.second.size() >= 2) meshLinks += static_cast<int>(kv.second.size());
+    for (auto& kv : intraGroup)
+      if (kv.second.size() >= 2)
+        intraLinks += static_cast<int>(kv.second.size());
+    std::fprintf(stderr,
+                 "FLOOD_CENSUS cells=%d classes=%d inconsistentClasses=%d "
+                 "flippedCells=%d meshLinkCells=%d intraLinkCells=%d\n",
+                 n, static_cast<int>(classVote.size()), nInconsistentClass,
+                 nFlip, meshLinks, intraLinks);
+  }
+}
+
+// ACT3 PER-EDGE MEASUREMENT (ACT3_PROBE, default OFF -> byte-identical).  The
+// shared cell complex is the recorded FloodCell buffer keyed by canonical
+// sub-edge.  For every canonical sub-edge, sum the emitted-halfedge direction
+// over RETAINED cells (dir = se.dir when keep==1, -se.dir when keep==2, 0 when
+// dropped); a nonzero net is an OPEN sub-edge (the SplitTouchingSheets fwd!=bwd
+// imbalance).  For each open sub-edge, dump the full incidence: every cell
+// (retained + DROPPED) that borders it, with its face, per-cell winding, keep,
+// and directed contribution - the decisive per-edge picture the per-cell
+// centroid probe cannot see.  This answers: is the missing partner a DROPPED
+// cell whose per-edge retention would balance the edge, or is there no incident
+// partner at all (a genuine synthesis gap)?
+void A3AnalyzeOpenEdges() {
+  const int n = static_cast<int>(gFlood.cells.size());
+  struct Inc {
+    int cell, dir;  // dir = emitted-halfedge sign (0 if dropped)
+  };
+  std::map<std::array<int64_t, 6>, std::vector<Inc>> byEdge;
+  for (int i = 0; i < n; ++i) {
+    const FloodCell& c = gFlood.cells[i];
+    for (const FloodSubEdge& e : c.edges) {
+      const int hedir = c.keep == 1 ? e.dir : (c.keep == 2 ? -e.dir : 0);
+      byEdge[e.key].push_back({i, hedir});
+    }
+  }
+  int nOpen = 0, nWithDroppedPartner = 0, nNoPartner = 0;
+  const bool dump = std::getenv("ACT3_EDGEDUMP") != nullptr;
+  for (auto& kv : byEdge) {
+    int net = 0, nRet = 0, nDrop = 0;
+    for (const Inc& in : kv.second) {
+      if (in.dir != 0) {
+        net += in.dir;
+        ++nRet;
+      } else {
+        ++nDrop;
+      }
+    }
+    if (net == 0) continue;  // balanced (closed) sub-edge
+    ++nOpen;
+    // Would retaining an incident DROPPED cell balance it?  A dropped cell,
+    // retained with keep=1 contributes +se.dir along the edge, keep=2 -se.dir;
+    // pick the orientation whose sign OPPOSES net (reducing |net| toward
+    // balance).  Mark that dropped cell for force-retention.
+    bool hasCandidate = false;
+    for (const Inc& inc : kv.second)
+      if (inc.dir == 0) hasCandidate = true;  // any incident dropped partner
+    if (hasCandidate)
+      ++nWithDroppedPartner;
+    else
+      ++nNoPartner;
+    if (dump) {
+      std::fprintf(stderr, "ACT3_OPEN key=(%lld,%lld,%lld)-(%lld,%lld,%lld) net=%d ret=%d drop=%d\n",
+                   (long long)kv.first[0], (long long)kv.first[1],
+                   (long long)kv.first[2], (long long)kv.first[3],
+                   (long long)kv.first[4], (long long)kv.first[5], net, nRet,
+                   nDrop);
+      for (const Inc& in : kv.second) {
+        const FloodCell& c = gFlood.cells[in.cell];
+        std::fprintf(stderr,
+                     "  cell f=%d w+=%d w-=%d keep=%d hedir=%d area=%.3g\n",
+                     c.face, c.wAbove, c.wBelow, c.keep, in.dir, c.area);
+      }
+    }
+  }
+  std::fprintf(stderr,
+               "ACT3_EDGECENSUS cells=%d openSubEdges=%d withDroppedPartner=%d "
+               "noPartner=%d\n",
+               n, nOpen, nWithDroppedPartner, nNoPartner);
+}
+
+inline std::array<int64_t, 6> A3EdgeKey(const vec3& p, const vec3& q, double h) {
+  const std::array<int64_t, 3> kp = FloodQ(p, h), kq = FloodQ(q, h);
+  if (std::lexicographical_compare(kp.begin(), kp.end(), kq.begin(), kq.end()))
+    return {kp[0], kp[1], kp[2], kq[0], kq[1], kq[2]};
+  return {kq[0], kq[1], kq[2], kp[0], kp[1], kp[2]};
+}
+
+// Directed halfedge balance over the FULL emitted soup (fold + seamed + clean)
+// at the eps weld grid: net!=0 -> a REAL open sub-edge (the SplitTouchingSheets
+// fwd!=bwd imbalance, computed pre-weld on canonical keys).  Returns key->net.
+std::map<std::array<int64_t, 6>, int> A3RealOpenKeys(
+    const std::vector<OutTri3D>& emitted, double h) {
+  std::map<std::array<int64_t, 6>, int> net;
+  for (const OutTri3D& t : emitted)
+    for (int j = 0; j < 3; ++j) {
+      const vec3& p = t.v[j];
+      const vec3& q = t.v[(j + 1) % 3];
+      const std::array<int64_t, 3> kp = FloodQ(p, h), kq = FloodQ(q, h);
+      if (kp == kq) continue;
+      const bool fwd =
+          std::lexicographical_compare(kp.begin(), kp.end(), kq.begin(),
+                                       kq.end());
+      net[A3EdgeKey(p, q, h)] += fwd ? 1 : -1;
+    }
+  std::map<std::array<int64_t, 6>, int> open;
+  for (auto& kv : net)
+    if (kv.second != 0) open.emplace(kv.first, kv.second);
+  return open;
+}
+
+// PER-EDGE RECOVERY population: for each REAL open sub-edge, mark the incident
+// DROPPED seamed cell for force-retention with the orientation that balances
+// the edge.  Empty when there are no real opens (whole resolving corpus) ->
+// byte-identical.
+void A3PopulateRecovery(const std::vector<OutTri3D>& emitted, double h) {
+  gAct3Recover.clear();
+  const auto open = A3RealOpenKeys(emitted, h);
+  if (open.empty()) return;
+  // Per-open-edge characterization (ACT3_EDGEDUMP): for each REAL open sub-edge,
+  // list the incident recorded cells with their windings + keep, and whether a
+  // DROPPED seamed partner exists.  This is the per-edge truth of the residue.
+  const bool dump = std::getenv("ACT3_EDGEDUMP") != nullptr;
+  int nReal = 0, nWithDropped = 0, nNoPartner = 0;
+  std::map<std::array<int64_t, 6>, std::vector<int>> incident;
+  for (int ci = 0; ci < static_cast<int>(gFlood.cells.size()); ++ci)
+    for (const FloodSubEdge& e : gFlood.cells[ci].edges)
+      if (open.count(e.key)) incident[e.key].push_back(ci);
+  for (const auto& kv : open) {
+    ++nReal;
+    const auto it = incident.find(kv.first);
+    bool hasDropped = false;
+    if (it != incident.end())
+      for (int ci : it->second)
+        if (gFlood.cells[ci].keep == 0) hasDropped = true;
+    if (hasDropped)
+      ++nWithDropped;
+    else
+      ++nNoPartner;
+    if (dump) {
+      std::fprintf(stderr, "ACT3_REALOPEN net=%d cells=%zu\n", kv.second,
+                   it == incident.end() ? 0 : it->second.size());
+      if (it != incident.end())
+        for (int ci : it->second) {
+          const FloodCell& c = gFlood.cells[ci];
+          std::fprintf(stderr, "  f=%d w+=%d w-=%d keep=%d area=%.3g\n", c.face,
+                       c.wAbove, c.wBelow, c.keep, c.area);
+        }
+    }
+  }
+  std::fprintf(stderr,
+               "ACT3_REALCENSUS realOpens=%d withDroppedSeamedPartner=%d "
+               "noSeamedPartner=%d\n",
+               nReal, nWithDropped, nNoPartner);
+  for (const FloodCell& c : gFlood.cells) {
+    if (c.keep != 0) continue;  // only dropped cells are recovery candidates
+    for (const FloodSubEdge& e : c.edges) {
+      const auto it = open.find(e.key);
+      if (it == open.end()) continue;
+      const int target = it->second > 0 ? -1 : 1;  // needed halfedge sign
+      const int keep = (e.dir == target) ? 1 : 2;
+      gAct3Recover.insert({{c.face, c.cenKey}, keep});
+      break;
+    }
+  }
+}
+
+// Pass-2 lookup: reconciled (wAbove, wBelow) for the cell at (face, cen3), or
+// nullopt if it was not recorded (a defensive fall-back to the live probe).
+inline bool FloodLookup(int face, const vec3& cen3, int& wa, int& wb) {
+  const auto it = gFlood.byCen.find({face, FloodQ(cen3, gFlood.h)});
+  if (it == gFlood.byCen.end()) return false;
+  wa = gFlood.cells[it->second].recWAbove;
+  wb = gFlood.cells[it->second].recWBelow;
+  return true;
+}
