+// ACT3 PER-EDGE RETENTION (ACT3_PEREDGE).  The per-cell centroid probe drops a
+// coincident/near-tangent PARTNER cell whose centroid is buried (w+ >=1 && w-
+// >=1) or exterior (both <1), even though its EDGE at a shared open sub-edge is
+// on d{w_S>=1}.  After the collect pass records the shared cell complex,
+// A3AnalyzeOpenEdges keys every canonical sub-edge and, for each one whose
+// RETAINED-cell halfedge balance is nonzero AND that borders a DROPPED seamed
+// cell, marks that dropped cell for retention with the orientation that
+// balances the edge.  The emit pass force-retains the marked cells.  On the
+// resolving corpus NO imbalanced sub-edge borders a dropped seamed cell
+// (measured withDroppedPartner==0 on every carrier), so the recovery never
+// fires -> byte-identical.  Keyed by (face, quantized centroid).
+struct Act3Key {
+  int face;
+  std::array<int64_t, 3> cenKey;
+  bool operator<(const Act3Key& o) const {
+    if (face != o.face) return face < o.face;
+    return cenKey < o.cenKey;
+  }
+};
+static std::map<Act3Key, int> gAct3Recover;  // -> forced keep (1 orig / 2 rev)
+static bool gAct3RecoverOnly = false;  // seamed emit: only the recovered cells
+static const bool kAct3PerEdge = std::getenv("ACT3_PEREDGE") != nullptr;
