+inline std::array<int64_t, 3> FloodQ(const vec3& p, double h) {
+  return {llround(static_cast<double>(p.x) / h),
+          llround(static_cast<double>(p.y) / h),
+          llround(static_cast<double>(p.z) / h)};
+}
+// Is q strictly on the segment [a,b] (collinear within tol, param in (tol,1-tol))?
+inline bool FloodOnSeg(const vec3& q, const vec3& a, const vec3& b, double eps) {
+  const vec3 d = b - a;
+  const double l2 = la::dot(d, d);
+  if (!(l2 > 0.0)) return false;
+  const double t = la::dot(q - a, d) / l2;
+  if (t < -1e-6 || t > 1.0 + 1e-6) return false;
+  const vec3 foot = a + t * d;
+  return la::length(q - foot) <= 4.0 * eps;
+}
+
+inline int BothSidesRetain(int wAbove, int wBelow);  // fwd decl (defined below)
+
+// Record one classified cell into the component-global flood buffer (pass 1).
+// tri3 = the source face's 3 corners; heBase = 3*face (mesh-edge twin lookup);
+// seamSegs = the face's seam segments (empty for clean faces); loop3 = the
+// cell's boundary 3D points in order.
+void FloodRecordCell(const Manifold::Impl& in, int face,
+                     const std::array<vec3, 3>& tri3,
+                     const std::vector<std::pair<vec3, vec3>>& seamSegs,
+                     const vec3& cen3, int wAbove, int wBelow, double area,
+                     const std::vector<vec3>& loop3, double eps,
+                     const vec3& nHat) {
+  const double h = gFlood.h;
+  FloodCell fc;
+  fc.face = face;
+  fc.cenKey = FloodQ(cen3, h);
+  fc.wAbove = wAbove;
+  fc.wBelow = wBelow;
+  fc.area = area;
+  fc.recWAbove = wAbove;
+  fc.recWBelow = wBelow;
+  fc.keep = BothSidesRetain(wAbove, wBelow);
+  fc.cen3 = cen3;
+  fc.nHat = nHat;
+  const int m = static_cast<int>(loop3.size());
+  for (int i = 0; i < m; ++i) {
+    const vec3& p = loop3[i];
+    const vec3& q = loop3[(i + 1) % m];
+    if (la::length(p - q) <= eps) continue;  // degenerate sub-edge
+    FloodSubEdge se;
+    const std::array<int64_t, 3> kp = FloodQ(p, h), kq = FloodQ(q, h);
+    // canonical (min,max) ordering of the endpoint pair; se.dir = +1 when the
+    // loop order p->q equals the canonical min->max, else -1 (act3 per-edge:
+    // the emitted-halfedge direction along this sub-edge is se.dir when the
+    // cell is retained CCW (keep==1), -se.dir when reversed (keep==2)).
+    if (std::lexicographical_compare(kp.begin(), kp.end(), kq.begin(),
+                                     kq.end())) {
+      se.key = {kp[0], kp[1], kp[2], kq[0], kq[1], kq[2]};
+      se.dir = 1;
+    } else {
+      se.key = {kq[0], kq[1], kq[2], kp[0], kp[1], kp[2]};
+      se.dir = -1;
+    }
+    // classify: on an original mesh edge (cross-face delta-0), a seam (no
+    // link), or interior non-seam (intra-face delta-0).
+    se.kind = 2;
+    se.meshId = -1;
+    bool isSeam = false;
+    for (const auto& s : seamSegs)
+      if (FloodOnSeg(p, s.first, s.second, eps) &&
+          FloodOnSeg(q, s.first, s.second, eps)) {
+        isSeam = true;
+        break;
+      }
+    if (isSeam) {
+      se.kind = 1;
+    } else {
+      for (int j = 0; j < 3; ++j)
+        if (FloodOnSeg(p, tri3[j], tri3[(j + 1) % 3], eps) &&
+            FloodOnSeg(q, tri3[j], tri3[(j + 1) % 3], eps)) {
+          const int he = 3 * face + j;
+          const int pr = in.halfedge_.Pair(he);
+          se.kind = 0;
+          se.meshId = pr >= 0 ? std::min(he, pr) : he;
+          // FLOOD_CLEANEDGE: restrict cross-face links to the FULL untouched
+          // mesh edge (endpoints == the two original corners, no interior
+          // junction split).  The above->above equality identity is proven only
+          // for CLEAN edges; a subdivided cluster edge carries coincident-sheet
+          // junctions where it breaks.  Diagnostic filter (default off).
+          if (std::getenv("FLOOD_CLEANEDGE") != nullptr) {
+            const vec3& e0 = tri3[j];
+            const vec3& e1 = tri3[(j + 1) % 3];
+            const bool full =
+                (la::length(p - e0) <= eps || la::length(p - e1) <= eps) &&
+                (la::length(q - e0) <= eps || la::length(q - e1) <= eps);
+            if (!full) {
+              se.kind = 3;  // subdivided (dirty) mesh edge: no link
+              se.meshId = -1;
+            }
+          }
+          break;
+        }
+    }
+    fc.edges.push_back(se);
+  }
+  const int idx = static_cast<int>(gFlood.cells.size());
+  gFlood.byCen[{face, fc.cenKey}] = idx;
+  gFlood.cells.push_back(std::move(fc));
+}
