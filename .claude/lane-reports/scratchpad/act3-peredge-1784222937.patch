+// ===========================================================================
+// FLOOD CLASSIFY (floodclose lane): component-global cross-face-consistent
+// winding reconciliation.  The per-face retention probe (RobustWinding at
+// cen3 +/- eps*nHat, EmitSeamedFace/EmitCleanFaces) classifies a DIFFERENT 3D
+// point per face; in the crowded multiply-wound cluster two faces on a shared
+// edge land in different tiny cells and DISAGREE, dropping each other's mates
+// (fracture-1784218577: the absent-partner opens).  The cleanflood identity
+// (act3-cleanflood-1784172149) proves w_above is EQUAL across every clean mesh
+// edge (above->above, combinatorial, sign-free) and across intra-face non-seam
+// sub-edges (a mere subdivision, no winding change).  So cells joined by such
+// delta-0 links form an equality CLASS whose w_above must be constant; where
+// the per-face probe disagrees inside a class (a graze), reconcile to the
+// area-weighted consensus.  This needs NO seam sign and NO seed: it only
+// enforces the proven equalities, so it is a NO-OP wherever the probe is
+// already consistent (the whole resolving corpus, per cleanflood neq==0) and
+// fires only at the openscad disagreement.  Gated FLOOD_CLASSIFY (default OFF
+// -> byte-identical); a two-pass collect(record cells)->reconcile->emit(look up
+// the reconciled winding) drive in EmitComponentBoundary.
+struct FloodSubEdge {
+  std::array<int64_t, 6> key;  // canonical (min,max) quantized endpoint pair
+  int kind;                    // 0 mesh-edge (cross-face delta0), 1 seam
+                               // (no link), 2 interior non-seam (intra delta0)
+  int64_t meshId;              // canonical twin mesh-edge id (kind 0), else -1
+  int dir = 0;  // +1 if loop-order p->q == canonical min->max, else -1 (act3)
+};
+struct FloodCell {
+  int face;
+  std::array<int64_t, 3> cenKey;  // quantized centroid (lookup key, bit-stable)
+  int wAbove, wBelow;
+  double area;  // reconcile weight (largest cell = most reliable probe)
+  std::vector<FloodSubEdge> edges;
+  int recWAbove, recWBelow;  // reconciled (filled by FloodReconcile)
+  int keep = 0;    // BothSidesRetain(wA,wB): 0 drop / 1 orig / 2 rev (act3)
+  vec3 cen3, nHat;  // interior classify point + face normal (act3 per-edge)
+};
+struct FloodCtx {
+  bool active = false;   // FLOOD_CLASSIFY on
+  bool collect = false;  // pass 1 (record cells, suppress emit)
+  double h = 1.0;        // quantization grid = weld radius (eps)
+  std::vector<FloodCell> cells;
+  std::map<std::pair<int, std::array<int64_t, 3>>, int> byCen;  // -> cell idx
+};
+static FloodCtx gFlood;
+static const bool kFloodClassify = std::getenv("FLOOD_CLASSIFY") != nullptr;
