+  nFlagFaces = static_cast<int>(flagged.size());
+  if (std::getenv("EX2_CENSUS") != nullptr)
+    std::fprintf(stderr, "EX2_WEDGE flaggedFaces=%d splitsAdded=%d triples=%d\n",
+                 nFlagFaces, nSplitsAdded, static_cast<int>(tab.size()));
 }
 
