+// C3 COMPLETION PROBE (attack22-c3, MEASUREMENT ONLY, env C3_COMPLETE).  Weld
+// the emitted soup, find the unbalanced-fan open edges, group the dangling
+// halfedges into connected components, and for each SIMPLE-CYCLE component that
+// lies in ONE input plane, form the candidate completion triangulation and
+// validate every triangle with the PRODUCTION winding (both-sides {w>=1} rule,
+// verbatim from EmitSeamedFace).  Prints how many of the open edges a
+// winding-only, single-plane completion would close, and which components need
+// multi-plane sheet synthesis (the gated arrangement).  Does NOT modify the
+// emitted soup - production BuildImpl is byte-unchanged.
+void C3CompletionProbe(const Manifold::Impl& in, const BuildArrangement& A,
+                       const std::vector<OutTri3D>& emitted,
+                       const std::vector<int>& emitSrc,
+                       const std::vector<vec3>& seeds, double eps) {
+  // --- weld (mirror BuildImpl exactly) ---
+  std::vector<vec3> verts;
+  std::unordered_map<GridCell, std::vector<int>, GridCellHash> grid;
+  auto cellOf = [&](vec3 p) -> GridCell {
+    return {static_cast<int64_t>(std::floor(p.x / eps)),
+            static_cast<int64_t>(std::floor(p.y / eps)),
+            static_cast<int64_t>(std::floor(p.z / eps))};
+  };
+  auto getV = [&](vec3 p) -> int {
+    const GridCell c = cellOf(p);
+    int best = -1;
+    for (const int64_t dx : {-1, 0, 1})
+      for (const int64_t dy : {-1, 0, 1})
+        for (const int64_t dz : {-1, 0, 1}) {
+          const auto it = grid.find({c.x + dx, c.y + dy, c.z + dz});
+          if (it == grid.end()) continue;
+          for (const int i : it->second)
+            if ((best < 0 || i < best) && la::length(verts[i] - p) <= eps)
+              best = i;
+        }
+    if (best >= 0) return best;
+    const int id = static_cast<int>(verts.size());
+    verts.push_back(p);
+    grid[c].push_back(id);
+    return id;
+  };
+  std::vector<ivec3> tv;
+  std::vector<int> src;
+  std::set<std::tuple<int, int, int>> seen;
+  for (size_t i = 0; i < emitted.size(); ++i) {
+    const int v0 = getV(emitted[i].v[0]), v1 = getV(emitted[i].v[1]),
+              v2 = getV(emitted[i].v[2]);
+    if (v0 == v1 || v1 == v2 || v0 == v2) continue;
+    int a = v0, b = v1, c = v2;
+    if (b < a && b < c) {
+      a = v1;
+      b = v2;
+      c = v0;
+    } else if (c < a && c < b) {
+      a = v2;
+      b = v0;
+      c = v1;
+    }
+    if (!seen.insert({a, b, c}).second) continue;
+    tv.push_back({v0, v1, v2});
+    src.push_back(i < emitSrc.size() ? emitSrc[i] : -99);
+  }
+  // --- find dangling halfedges (unbalanced fans) ---
+  const int nTri = static_cast<int>(tv.size());
+  auto heFrom = [&](int h) { return tv[h / 3][h % 3]; };
+  auto heTo = [&](int h) { return tv[h / 3][(h % 3 + 1) % 3]; };
+  std::map<std::pair<int, int>, std::vector<int>> edge2he;
+  for (int h = 0; h < 3 * nTri; ++h)
+    edge2he[{std::min(heFrom(h), heTo(h)), std::max(heFrom(h), heTo(h))}]
+        .push_back(h);
+  std::vector<int> dangHE;  // dangling directed halfedges
+  for (const auto& [e, hes] : edge2he) {
+    int fwd = 0, bwd = 0;
+    for (const int h : hes) (heFrom(h) == e.first ? fwd : bwd)++;
+    if (fwd == bwd) continue;
+    for (const int h : hes) dangHE.push_back(h);
+  }
+  const int openEdges =
+      static_cast<int>(std::count_if(edge2he.begin(), edge2he.end(),
+                                     [&](const auto& kv) {
+                                       int f = 0, b = 0;
+                                       for (int h : kv.second)
+                                         (heFrom(h) == kv.first.first ? f : b)++;
+                                       return f != b;
+                                     }));
+  // --- union-find components over dangling verts ---
+  std::map<int, int> vidx;
+  for (const int h : dangHE) {
+    vidx.emplace(heFrom(h), static_cast<int>(vidx.size()));
+    vidx.emplace(heTo(h), static_cast<int>(vidx.size()));
+  }
+  DisjointSets uf(static_cast<int>(vidx.size()));
+  for (const int h : dangHE)
+    uf.unite(vidx[heFrom(h)], vidx[heTo(h)]);
+  std::map<int, std::vector<int>> comp;  // root -> dangling HEs
+  for (const int h : dangHE) comp[uf.find(vidx[heFrom(h)])].push_back(h);
+  // --- per component ---
+  int closableEdges = 0, closableComps = 0, multiPlaneComps = 0, branchComps = 0;
+  for (auto& [root, hes] : comp) {
+    std::set<int> vs;
+    std::map<int, int> outd, ind;
+    for (const int h : hes) {
+      vs.insert(heFrom(h));
+      vs.insert(heTo(h));
+      outd[heFrom(h)]++;
+      ind[heTo(h)]++;
+    }
+    // count this component's open edges
+    std::set<std::pair<int, int>> ce;
+    for (const int h : hes)
+      ce.insert({std::min(heFrom(h), heTo(h)), std::max(heFrom(h), heTo(h))});
+    const int cEdges = static_cast<int>(ce.size());
+    // single input plane containing ALL verts?
+    int plane = -1;
+    for (int f = 0; f < static_cast<int>(in.NumTri()); ++f) {
+      const vec3 n = A.faceN[f];
+      const double nl = la::length(n);
+      if (!(nl > 0.0)) continue;
+      bool all = true;
+      for (const int v : vs)
+        if (std::abs(la::dot(n, verts[v] - A.tri[f][0])) / nl > eps) {
+          all = false;
+          break;
+        }
+      if (all) {
+        plane = f;
+        break;
+      }
+    }
+    // simple cycle iff every vertex has in==out==1
+    bool simple = true;
+    for (const int v : vs)
+      if (outd[v] != 1 || ind[v] != 1) simple = false;
+    if (plane < 0) {
+      ++multiPlaneComps;
+      std::fprintf(stderr,
+                   "C3C_COMP verts=%zu edges=%d plane=NONE simple=%d -> "
+                   "MULTI-PLANE (needs gated sheet synthesis)\n",
+                   vs.size(), cEdges, simple ? 1 : 0);
+      continue;
+    }
+    // SINGLE-PLANE completion (simple OR branch): fan every dangling halfedge
+    // (a->b) to an in-plane Steiner centroid C, emitting triangle (C,b,a) whose
+    // b->a pairs the dangling a->b and whose spokes pair among themselves - so
+    // the whole component's fans close.  C is in the input plane, so no face
+    // leaves an input plane (boundary SET unperturbed).  Validate EACH triangle
+    // with the PRODUCTION both-sides {w>=1} winding rule (verbatim
+    // EmitSeamedFace) - a completion face the winding rejects means the region
+    // is not all-boundary, so the component does NOT cleanly close.
+    const vec3 nHat = A.faceN[plane] / la::length(A.faceN[plane]);
+    vec3 csum(0.0, 0.0, 0.0);
+    for (const int v : vs) csum += verts[v];
+    vec3 cen0 = csum / static_cast<double>(vs.size());
+    cen0 -= la::dot(nHat, cen0 - A.tri[plane][0]) * nHat;  // project into plane
+    int retained = 0, dropped = 0, filterFail = 0;
+    for (const int h : hes) {
+      const vec3 pa = verts[heTo(h)], pb = verts[heFrom(h)];  // (C, b, a)
+      const vec3 cen = (cen0 + pa + pb) / 3.0;
+      const std::optional<int> g = RobustWinding(in, cen + eps * nHat, seeds);
+      const std::optional<int> gb = RobustWinding(in, cen - eps * nHat, seeds);
+      if (!g || !gb) {
+        ++filterFail;
+        continue;
+      }
+      if ((*g >= 1) == (*gb >= 1))
+        ++dropped;
+      else
+        ++retained;
+    }
+    const bool closes =
+        (dropped == 0 && filterFail == 0 && retained == static_cast<int>(hes.size()));
+    if (closes) {
+      ++closableComps;
+      closableEdges += cEdges;
+    } else {
+      ++branchComps;  // reuse counter: single-plane but not cleanly closed
+    }
+    std::fprintf(stderr,
+                 "C3C_COMP verts=%zu edges=%d plane=%d simple=%d fanTris=%zu "
+                 "retained=%d dropped=%d filterFail=%d -> %s\n",
+                 vs.size(), cEdges, plane, simple ? 1 : 0, hes.size(), retained,
+                 dropped, filterFail,
+                 closes ? "CLOSES(winding-valid)" : "NOT-CLOSED(winding rejects)");
+  }
+  std::fprintf(stderr,
+               "C3C_SUMMARY openEdges=%d comps=%zu closableComps=%d "
+               "closableEdges=%d multiPlaneComps=%d branchComps=%d "
+               "trajectory=%d->%d\n",
+               openEdges, comp.size(), closableComps, closableEdges,
+               multiPlaneComps, branchComps, openEdges,
+               openEdges - closableEdges);
+}
