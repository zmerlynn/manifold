+// SLIVER-EMIT stage 1 (COMMITTED POSITIONS): rewrite every seam endpoint to its
+// registry-canonical position, so that a junction constructed via two different
+// pierce arithmetic paths (edge_i-pierces-tri_j vs edge_j-pierces-tri_i - the
+// same math point, ULP-apart bits: the EntangledBarsRotated twins) arrives at
+// EVERY incident face's emission with ONE committed double position, bit-equal.
+// The registry (A.junctions) already deduped the twin cluster to its sorted-
+// lowest representative; snapping both twins onto it makes them bit-equal by
+// construction, so the assembly equality-weld (stage 2) suffices without the
+// eps grid.  A.junctions is sorted by (x,y,z), so the candidate window starts at
+// the first vertex with x >= P.x - eps.  Env-gated (SLV_CANON) so the default
+// path stays byte-identical while the stack is measured.  On the resolving
+// corpus the only within-eps registry neighbour of a seam endpoint is its own
+// twin (nomerge aliasGap=0: no cross-provenance aliasing off openscad), so this
+// is exactly twin unification there - a re-triangulation only where twins exist.
+void CanonicalizeSeamEndpoints(BuildArrangement& A, double eps) {
+  if (std::getenv("SLV_CANON") == nullptr) return;
+  // Ground-truth positions in preference order: an exact INPUT VERTEX (position
+  // IS provenance) beats a rounded construction, so a seam endpoint that lands
+  // within eps of a triangle corner commits to that corner's exact bits (the
+  // INPUT-SEAM twin: a seam terminating at a cap corner, y=0.99999.. -> y=1).
+  // The registry's sorted-lowest representative is the fallback for SEAM-SEAM /
+  // SEAM-TRIPLE clusters with no input-vertex member.  A single sorted vector of
+  // {input-verts, then registry} lets one x-windowed scan honour the preference.
+  std::vector<vec3> inputV;
+  for (const auto& tri : A.tri)
+    for (const vec3& c : tri) inputV.push_back(c);
+  std::sort(inputV.begin(), inputV.end(), [](const vec3& p, const vec3& q) {
+    return std::tie(p.x, p.y, p.z) < std::tie(q.x, q.y, q.z);
+  });
+  auto snapTo = [&](const std::vector<vec3>& src, vec3& P) -> bool {
+    for (const vec3& J : src) {
+      if (J.x < P.x - eps) continue;
+      if (J.x > P.x + eps) break;
+      if (la::length(J - P) <= eps) {
+        P = J;
+        return true;
+      }
+    }
+    return false;
+  };
+  auto canon = [&](vec3& P) {
+    if (snapTo(inputV, P)) return;  // exact input vertex wins
+    snapTo(A.junctions, P);         // else the once-only registry rep
+  };
+  for (auto& seams : A.faceSeams)
+    for (auto& s : seams) {
+      canon(s.p0);
+      canon(s.p1);
+    }
+}
