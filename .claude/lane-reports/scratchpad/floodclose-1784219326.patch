+// Pass-2 lookup: reconciled (wAbove, wBelow) for the cell at (face, cen3), or
+// nullopt if it was not recorded (a defensive fall-back to the live probe).
+inline bool FloodLookup(int face, const vec3& cen3, int& wa, int& wb) {
+  const auto it = gFlood.byCen.find({face, FloodQ(cen3, gFlood.h)});
+  if (it == gFlood.byCen.end()) return false;
+  wa = gFlood.cells[it->second].recWAbove;
+  wb = gFlood.cells[it->second].recWBelow;
+  return true;
+}
