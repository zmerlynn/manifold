+inline sos::BigHPoint IXProvHPoint(const BuildArrangement& A,
+                                   const BuildArrangement::VProv& pv) {
+  if (pv.trivial) return sos::TrivialBigHPoint(pv.v);
+  return IXTripleHPoint(A, pv.rf, pv.rg, pv.rh);
